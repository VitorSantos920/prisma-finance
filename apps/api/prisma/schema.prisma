datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password_hash String
  role          Role     @default(OWNER)
  updated_at    DateTime @updatedAt
  created_at    DateTime @default(now())
}

enum Role {
  DEVELOPER
  OWNER
}
